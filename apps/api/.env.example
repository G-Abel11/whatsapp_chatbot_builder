# Copy to .env and fill in for your environment. app.core.config reads .env
# automatically (pydantic-settings); every value can also be set as a real
# environment variable, which takes precedence.

# ── Persistence ──────────────────────────────────────────────────────────────
# Local dev: SQLite (no Docker needed). Production: Postgres via docker compose.
DATABASE_URL=sqlite+aiosqlite:///./opes.db
# DATABASE_URL=postgresql+asyncpg://opes:opes@localhost:5432/opes
# REDIS_URL=redis://localhost:6379/0

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
# Permanent access token from the Meta app dashboard. Unset (or "change-me*")
# = dry-run sender: messages are logged, nothing is sent. A flow can also set
# its own per-bot token in the builder, which takes precedence over this.
# WHATSAPP_ACCESS_TOKEN=
# App secret of the Meta app — used to verify X-Hub-Signature-256 on /webhook.
# WHATSAPP_APP_SECRET=
# Token you configure in Meta's "Callback URL (Webhook)" verification field.
# WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# WHATSAPP_GRAPH_VERSION=v21.0
# VERIFY_SIGNATURE=true

# ── App ──────────────────────────────────────────────────────────────────────
# ENVIRONMENT=local
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# BASE_URL=http://localhost:8000
